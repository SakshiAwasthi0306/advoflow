# AdvoFlow configuration. Copy to .env.local (never commit .env.local or .env).
# Every variable is optional for local demo mode: `npm run dev` works with this file unchanged.
# Values are validated at startup (src/lib/env.ts); problems are reported by variable name in GET /api/health.

# --- App -------------------------------------------------------------
# Public base URL of the app (optional). Example: https://advoflow.example.com
APP_URL=
# debug | info | warn | error (default: info; debug in `npm run dev`)
LOG_LEVEL=

# --- Mode -------------------------------------------------------------
# "demo" (default): single demo office, no login.
# "password": email + password login, office-level isolation enforced on the server.
# Any other value is treated as "password" (fails closed).
AUTH_MODE=demo
# Required when AUTH_MODE=password. 32+ random characters, e.g. `openssl rand -base64 48`.
AUTH_SECRET=

# --- Database ---------------------------------------------------------
# Empty = local file store in .data/ (demo only, not for real data, does not persist on Vercel).
# PostgreSQL (e.g. Neon): pooled URL for the app, direct URL for migrations and Prisma CLI.
# Then run `npm run db:migrate`. Check with `curl localhost:3000/api/health/ready`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Document storage -------------------------------------------------
# Local folder for uploads when no Blob token is set. Must not be publicly served.
DOCUMENT_STORAGE_DIR=.data/uploads
# Private Vercel Blob store for uploads (set automatically when a Blob store is connected on Vercel).
BLOB_READ_WRITE_TOKEN=

# --- AI (server-side only; not needed for the health endpoints) -------
# Empty = rule-based demo extractor and rule-based research.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Legal research source --------------------------------------------
# demo        = small FICTIONAL corpus
# opendata    = real eCourts judgments loaded into PostgreSQL (scripts/judgments/load_judgments.py); needs DATABASE_URL
# indiankanoon= Indian Kanoon API (needs INDIAN_KANOON_API_TOKEN)
# none        = no judgments
RESEARCH_CONNECTOR=demo
INDIAN_KANOON_API_TOKEN=
