# AdvoFlow configuration. Copy to .env.local (never commit .env.local or .env).
# Every variable is optional for local demo mode: `npm run dev` works with this file unchanged.
# Values are validated at startup (src/lib/env.ts); problems are reported by variable name in GET /api/health.

# --- App -------------------------------------------------------------
# Public base URL of the app (optional). Example: https://advoflow.example.com
APP_URL=
# debug | info | warn | error (default: info; debug in `npm run dev`)
LOG_LEVEL=

# --- Mode -------------------------------------------------------------
# "demo" (default): single demo office, no login.
# "password": email + password login, office-level isolation enforced on the server.
# Any other value is treated as "password" (fails closed).
AUTH_MODE=demo
# Required when AUTH_MODE=password. 32+ random characters, e.g. `openssl rand -base64 48`. Signs session cookies.
# Password mode also requires DATABASE_URL (accounts and sessions are stored in PostgreSQL).
AUTH_SECRET=
# Password mode only. "true" opens POST /api/auth/register to anyone (each registration gets its own new office).
# Default: closed — create accounts with `npm run create-user` instead.
ALLOW_REGISTRATION=false
# Two-step login: every sign-in needs a 6-digit code sent by email (password mode). "off" = password only.
TWO_STEP_LOGIN=required
# Two-step login: every sign-in needs a 6-digit code sent by email (password mode).
# Set a Resend API key and a sender on a domain verified in Resend to send real emails:
RESEND_API_KEY=
EMAIL_FROM=
# Without a key, codes are written to the server log in development only ("log"); in production nobody can finish
# signing in until RESEND_API_KEY is set. EMAIL_DELIVERY=log forces log delivery (automated tests only, never real users).
EMAIL_DELIVERY=
# Mobile-number verification codes. No SMS provider is wired in yet: "log" writes codes to the server log
# (development/tests only); production default is none (adding a mobile number answers 503).
SMS_DELIVERY=

# --- Database ---------------------------------------------------------
# Empty = local file store in .data/ (demo only, not for real data, does not persist on Vercel).
# PostgreSQL (e.g. Neon): pooled URL for the app, direct URL for migrations and Prisma CLI.
# Then run `npm run db:migrate`. Check with `curl localhost:3000/api/health/ready`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Document storage -------------------------------------------------
# Local folder for uploads when no Blob token is set. Must not be publicly served.
DOCUMENT_STORAGE_DIR=.data/uploads
# Private Vercel Blob store for uploads (set automatically when a Blob store is connected on Vercel).
BLOB_READ_WRITE_TOKEN=

# --- AI (server-side only; not needed for the health endpoints) -------
# Empty = rule-based demo extractor and rule-based research.
# --- AI for court-order extraction (server-side only; never NEXT_PUBLIC_). See docs/ai.md.
# OpenRouter key (https://openrouter.ai/keys). Used when GEMINI_API_KEY is empty.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
# Or Google Gemini directly (https://aistudio.google.com/apikey); takes precedence when set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# OpenRouter: only zero-data-retention endpoints (default true). Set false only after reviewing the providers' terms.
AI_ZERO_DATA_RETENTION=
# Limits (defaults shown): per-attempt timeout, output tokens, characters read, calls per person per hour / office per day.
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=8192
AI_MAX_INPUT_CHARS=60000
AI_USER_HOURLY_LIMIT=30
AI_OFFICE_DAILY_LIMIT=200
# All AI calls on this site per day, across every account (bounds the bill when sign-up is open).
AI_SITE_DAILY_LIMIT=300
# The shared public demo (AUTH_MODE=demo) never calls the AI unless this is true.
AI_IN_DEMO=
# Older provider, used only when neither key above is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Legal research source --------------------------------------------
# demo        = small FICTIONAL corpus
# opendata    = real eCourts judgments loaded into PostgreSQL (scripts/judgments/load_judgments.py); needs DATABASE_URL
# indiankanoon= Indian Kanoon API (needs INDIAN_KANOON_API_TOKEN)
# none        = no judgments
RESEARCH_CONNECTOR=demo
INDIAN_KANOON_API_TOKEN=
