# --- Mode -------------------------------------------------------------
# "demo" (default): single demo office, no login, data in .data/ on this machine.
# "password": email + password login, office-level isolation enforced on the server.
AUTH_MODE=demo
# Required when AUTH_MODE=password. Long random string used to sign session cookies.
AUTH_SECRET=

# --- Database ---------------------------------------------------------
# Leave empty to use the local file store in .data/ (demo only, not secure for real data).
# Set to a PostgreSQL URL to use the relational store (run `npm run db:migrate` first).
DATABASE_URL=

# --- Document storage -------------------------------------------------
# Folder for uploaded orders when using the local/demo setup. Must not be publicly served.
DOCUMENT_STORAGE_DIR=.data/uploads

# --- AI (server-side only) --------------------------------------------
# Leave empty to run the deterministic demo extractor and demo research.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Legal research source --------------------------------------------
# "demo" uses a small FICTIONAL corpus. "indiankanoon" uses the Indian Kanoon API (needs a token).
RESEARCH_CONNECTOR=demo
INDIAN_KANOON_API_TOKEN=
