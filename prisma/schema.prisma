// AdvoFlow data model (Step 2). Design notes and the decisions behind it: docs/data-model.md
//
// All tables live in the Postgres schema "app" and are created by Prisma Migrate (prisma/migrations).
// Until the app's data-access layer is switched to Prisma, the running app still uses the older tables in
// "public" (db/migrations/*.sql). The shared judgments table (public.legal_judgments, loaded by
// scripts/judgments/) is deliberately NOT in this schema: it is reference data with a full-text column
// Prisma cannot manage, and is read with SQL by src/lib/research/connectors.ts.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

// ---------------------------------------------------------------- enums

enum Role {
  OWNER
  ADVOCATE
  CLERK
  VIEWER

  @@schema("app")
}

enum Language {
  EN
  KN

  @@schema("app")
}

enum ContactChannel {
  WHATSAPP
  PHONE
  EMAIL

  @@schema("app")
}

enum CourtLevel {
  SUPREME
  HIGH
  DISTRICT
  TRIBUNAL
  OTHER

  @@schema("app")
}

enum CaseStatus {
  ACTIVE
  CLOSED
  ARCHIVED

  @@schema("app")
}

enum PartySide {
  PETITIONER
  RESPONDENT
  OTHER

  @@schema("app")
}

enum DocumentKind {
  ORDER
  CAUSE_LIST
  OTHER

  @@schema("app")
}

enum TextSource {
  PDF_TEXT
  OCR
  PASTED
  PLAIN_TEXT
  NONE

  @@schema("app")
}

enum JobStatus {
  NEEDS_REVIEW
  APPROVED
  REJECTED
  FAILED

  @@schema("app")
}

enum Extractor {
  DEMO_RULES
  ANTHROPIC
  CASE_DIARY_IMPORT

  @@schema("app")
}

enum HearingStatus {
  AWAITING_VERIFICATION
  CONFIRMED
  HELD
  SUPERSEDED
  CANCELLED

  @@schema("app")
}

enum TaskStatus {
  OPEN
  DONE

  @@schema("app")
}

enum TaskPriority {
  HIGH
  NORMAL
  LOW

  @@schema("app")
}

enum TaskSource {
  MANUAL
  ORDER
  RESEARCH
  IMPORT

  @@schema("app")
}

enum MessageStatus {
  DRAFT
  APPROVED
  HANDED_OFF // WhatsApp/email opened with the text; NOT proof of delivery

  @@schema("app")
}

enum ResearchMode {
  DEMO
  RULES
  PARTIAL
  LIVE

  @@schema("app")
}

enum ReviewStatus {
  NEEDS_REVIEW
  REVIEWED

  @@schema("app")
}

enum Stance {
  SUPPORTS
  LIMITS
  CONTRADICTS
  UNCLASSIFIED

  @@schema("app")
}

enum Bindingness {
  BINDING
  PERSUASIVE
  UNKNOWN

  @@schema("app")
}

enum Verification {
  FICTIONAL_DEMO
  UNVERIFIED
  SOURCE_RETRIEVED
  ADVOCATE_REVIEWED

  @@schema("app")
}

enum NoteAuthor {
  ADVOCATE
  AI

  @@schema("app")
}

// ---------------------------------------------------------------- tenancy and people

model Office {
  id         String   @id @default(cuid())
  name       String
  demoLoaded Boolean  @default(false)
  version    Int      @default(0) // bumped on every save; a stale save is rejected (optimistic locking)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  memberships      Membership[]
  courts           Court[]
  clients          Client[]
  cases            Case[]
  caseParties      CaseParty[]
  caseClients      CaseClient[]
  documents        Document[]
  extractionJobs   ExtractionJob[]
  orders           CourtOrder[]
  hearings         Hearing[]
  dateChanges      HearingDateChange[]
  tasks            Task[]
  messages         ClientMessage[]
  researchReports  ResearchReport[]
  researchVersions ResearchVersion[]
  authorities      ResearchAuthority[]
  savedAuthorities SavedAuthority[]
  researchNotes    ResearchNote[]
  auditLogs        AuditLog[]

  @@schema("app")
}

/// A person who can sign in. Credentials live in Account (provider "credential", Argon2id hash in `password`);
/// sessions in Session. Managed through Better Auth (src/lib/auth/); never returned with a password field.
model User {
  id            String   @id @default(cuid())
  email         String   @unique // normalised: trimmed, lower-case
  name          String
  emailVerified Boolean  @default(false)
  image         String?
  isActive      Boolean  @default(true) // false = cannot sign in; existing sessions are rejected
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  memberships Membership[]
  sessions    Session[]
  accounts    Account[]

  @@schema("app")
}

/// A signed-in browser. The cookie holds a signed reference to `token`; deleting the row ends the session.
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@schema("app")
}

/// A way to sign in for a user. For email + password: providerId "credential", accountId = userId, password = Argon2id hash.
model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@schema("app")
}

/// Better Auth "verification" table (short-lived tokens, e.g. future email verification / password reset). Unused in Step 4.
model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@index([identifier])
  @@schema("app")
}

/// Fixed-window request counters shared by every server instance (sign-in, registration).
model RateLimit {
  key     String   @id // e.g. "login:ip:203.0.113.5"
  count   Int
  resetAt DateTime @db.Timestamptz(6)

  @@index([resetAt])
  @@schema("app")
}

model Membership {
  id        String   @id @default(cuid())
  officeId  String
  userId    String
  role      Role
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([officeId, userId])
  @@unique([officeId, id]) // lets other tables reference "a member of THIS office"
  @@index([userId])
  @@schema("app")
}

// ---------------------------------------------------------------- reference data

/// Courts. Rows with officeId = null are the shared seeded list (Supreme Court, Karnataka High Court benches,
/// Karnataka district courts); an office can add its own. Cases may also just name a court in free text.
model Court {
  id        String     @id @default(cuid())
  officeId  String?
  name      String
  level     CourtLevel
  state     String?
  district  String?
  bench     String?
  code      String? // stable key for seeded rows, e.g. "KA-HC-BLR"
  createdAt DateTime   @default(now()) @db.Timestamptz(6)

  office Office? @relation(fields: [officeId], references: [id], onDelete: Cascade)
  cases  Case[]

  @@unique([code])
  @@index([officeId, name])
  @@schema("app")
}

// ---------------------------------------------------------------- clients and cases

model Client {
  id                String         @id @default(cuid())
  officeId          String
  name              String
  phone             String?
  email             String?
  preferredLanguage Language       @default(EN)
  preferredChannel  ContactChannel @default(WHATSAPP)
  notes             String         @default("")
  isDemo            Boolean        @default(false)
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(6)

  office   Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  cases    CaseClient[]
  messages ClientMessage[]

  @@unique([officeId, id])
  @@index([officeId, name])
  @@schema("app")
}

model Case {
  id        String     @id @default(cuid())
  officeId  String
  number    String // as written, e.g. "O.S. 482/2025"
  numberKey String? // normalised "OS|482|2025" for matching; null when it cannot be parsed
  cnr       String? // eCourts CNR, upper-case
  caseType  String     @default("")
  title     String     @default("")
  courtId   String?
  courtName String     @default("") // free text as written on the order; used when no Court row fits
  stage     String     @default("")
  status    CaseStatus @default(ACTIVE)
  actingFor PartySide?
  filedOn   DateTime?  @db.Date
  isDemo    Boolean    @default(false)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)

  office           Office              @relation(fields: [officeId], references: [id], onDelete: Cascade)
  court            Court?              @relation(fields: [courtId], references: [id], onDelete: SetNull)
  parties          CaseParty[]
  clients          CaseClient[]
  documents        Document[]
  orders           CourtOrder[]
  hearings         Hearing[]
  dateChanges      HearingDateChange[]
  tasks            Task[]
  messages         ClientMessage[]
  researchReports  ResearchReport[]
  savedAuthorities SavedAuthority[]

  @@unique([officeId, id])
  // One live case per normalised number in an office; archived cases may repeat a number.
  @@unique([officeId, numberKey], map: "case_office_number_live_uniq", where: raw("\"numberKey\" IS NOT NULL AND status <> 'ARCHIVED'"))
  @@unique([officeId, cnr], map: "case_office_cnr_uniq", where: raw("cnr IS NOT NULL"))
  @@index([officeId, status, updatedAt(sort: Desc)])
  @@schema("app")
}

model CaseParty {
  id       String    @id @default(cuid())
  officeId String
  caseId   String
  side     PartySide
  name     String
  position Int       @default(0) // order as listed in the cause title

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  case   Case   @relation(fields: [officeId, caseId], references: [officeId, id], onDelete: Cascade)

  @@index([officeId, caseId, side, position])
  @@schema("app")
}

model CaseClient {
  officeId  String
  caseId    String
  clientId  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  case   Case   @relation(fields: [officeId, caseId], references: [officeId, id], onDelete: Cascade)
  client Client @relation(fields: [officeId, clientId], references: [officeId, id], onDelete: Cascade)

  @@id([caseId, clientId])
  @@unique([caseId], map: "case_client_one_primary_uniq", where: raw("\"isPrimary\""))
  @@index([officeId, clientId])
  @@schema("app")
}

// ---------------------------------------------------------------- documents and order review

model Document {
  id           String       @id @default(cuid())
  officeId     String
  caseId       String?
  filename     String
  mime         String
  size         Int
  sha256       String
  storageKey   String // path in private storage; never served directly
  kind         DocumentKind @default(ORDER)
  textExtract  String?
  textSource   TextSource   @default(NONE)
  isDemo       Boolean      @default(false)
  uploadedById String? // user id
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)

  office Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  case   Case?           @relation(fields: [officeId, caseId], references: [officeId, id], onDelete: NoAction)
  jobs   ExtractionJob[]
  order  CourtOrder?

  @@unique([officeId, id])
  @@unique([officeId, sha256]) // the same file uploaded twice is one document
  @@index([officeId, caseId])
  @@schema("app")
}

/// One reading of a document (rules or AI), waiting for an advocate's decision.
/// `extraction` and `match` are kept as JSON on purpose: they are the record of what was PROPOSED.
model ExtractionJob {
  id             String    @id @default(cuid())
  officeId       String
  documentId     String
  idempotencyKey String
  status         JobStatus @default(NEEDS_REVIEW)
  extractor      Extractor
  model          String?
  hint           Json      @default("{}")
  extraction     Json?
  match          Json?
  conflicts      String[]  @default([])
  error          String?
  createdById    String?
  decidedById    String?
  decidedAt      DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  office   Office      @relation(fields: [officeId], references: [id], onDelete: Cascade)
  document Document    @relation(fields: [officeId, documentId], references: [officeId, id], onDelete: Cascade)
  order    CourtOrder?

  @@unique([officeId, id])
  @@index([officeId, status, createdAt])
  @@index([officeId, idempotencyKey])
  @@schema("app")
}

/// An order as APPROVED by an advocate: only the fields they ticked.
model CourtOrder {
  id                   String    @id @default(cuid())
  officeId             String
  caseId               String
  documentId           String
  jobId                String?
  orderDate            DateTime? @db.Date
  summary              String    @default("")
  stage                String    @default("")
  adjourned            Boolean   @default(false)
  costs                String? // as stated, e.g. "Rs. 500 payable to the plaintiff"
  directions           String[]  @default([])
  nextHearingDate      DateTime? @db.Date
  nextHearingConfirmed Boolean   @default(false)
  approvedFields       String[]  @default([])
  extractionSnapshot   Json?
  approvedById         String?
  approvedAt           DateTime  @default(now()) @db.Timestamptz(6)
  isDemo               Boolean   @default(false)

  office   Office         @relation(fields: [officeId], references: [id], onDelete: Cascade)
  case     Case           @relation(fields: [officeId, caseId], references: [officeId, id], onDelete: Cascade)
  document Document       @relation(fields: [officeId, documentId], references: [officeId, id], onDelete: Restrict)
  job      ExtractionJob? @relation(fields: [officeId, jobId], references: [officeId, id], onDelete: NoAction)

  hearingsSet Hearing[]           @relation("HearingSourceOrder")
  dateChanges HearingDateChange[]
  tasks       Task[]
  messages    ClientMessage[]

  @@unique([officeId, id])
  @@unique([officeId, documentId]) // a document becomes at most one order
  @@unique([officeId, jobId])
  @@index([officeId, caseId, orderDate])
  @@schema("app")
}

// ---------------------------------------------------------------- hearings and tasks

/// Hearing dates keep their history: a moved date is SUPERSEDED, never edited or deleted.
model Hearing {
  id             String        @id @default(cuid())
  officeId       String
  caseId         String
  date           DateTime      @db.Date
  purpose        String        @default("")
  status         HearingStatus
  sourceOrderId  String?
  supersededById String?
  confirmedById  String? // user id
  confirmedAt    DateTime?     @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)

  office       Office      @relation(fields: [officeId], references: [id], onDelete: Cascade)
  case         Case        @relation(fields: [officeId, caseId], references: [officeId, id], onDelete: Cascade)
  sourceOrder  CourtOrder? @relation("HearingSourceOrder", fields: [officeId, sourceOrderId], references: [officeId, id], onDelete: NoAction)
  supersededBy Hearing?    @relation("HearingSupersededBy", fields: [officeId, supersededById], references: [officeId, id], onDelete: NoAction)
  supersedes   Hearing[]   @relation("HearingSupersededBy")

  @@unique([officeId, id])
  @@index([officeId, date])
  @@index([officeId, caseId, status])
  @@schema("app")
}

model HearingDateChange {
  id              String   @id @default(cuid())
  officeId        String
  caseId          String
  fromDate        DateTime @db.Date
  toDate          DateTime @db.Date
  orderId         String?
  affectedTaskIds String[] @default([])
  reviewed        Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  office Office      @relation(fields: [officeId], references: [id], onDelete: Cascade)
  case   Case        @relation(fields: [officeId, caseId], references: [officeId, id], onDelete: Cascade)
  order  CourtOrder? @relation(fields: [officeId, orderId], references: [officeId, id], onDelete: NoAction)

  @@index([officeId, caseId, createdAt])
  @@schema("app")
}

model Task {
  id             String       @id @default(cuid())
  officeId       String
  caseId         String
  title          String
  description    String       @default("")
  dueDate        DateTime?    @db.Date
  priority       TaskPriority @default(NORMAL)
  status         TaskStatus   @default(OPEN)
  source         TaskSource   @default(MANUAL)
  sourceOrderId  String?
  sourceReportId String?
  dedupeKey      String? // stops retries from creating the same task twice
  assigneeId     String? // user id
  rescheduleFrom DateTime?    @db.Date // set when the hearing this task was due on moved; the advocate decides
  rescheduleTo   DateTime?    @db.Date
  createdById    String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  completedAt    DateTime?    @db.Timestamptz(6)

  office       Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  case         Case            @relation(fields: [officeId, caseId], references: [officeId, id], onDelete: Cascade)
  sourceOrder  CourtOrder?     @relation(fields: [officeId, sourceOrderId], references: [officeId, id], onDelete: NoAction)
  sourceReport ResearchReport? @relation(fields: [officeId, sourceReportId], references: [officeId, id], onDelete: NoAction)

  @@unique([officeId, caseId, dedupeKey], map: "task_dedupe_uniq", where: raw("\"dedupeKey\" IS NOT NULL"))
  @@index([officeId, status, dueDate])
  @@index([officeId, caseId])
  @@schema("app")
}

// ---------------------------------------------------------------- client communication

model ClientMessage {
  id            String          @id @default(cuid())
  officeId      String
  caseId        String
  clientId      String?
  lang          Language
  text          String
  status        MessageStatus   @default(DRAFT)
  channel       ContactChannel?
  sourceOrderId String?
  handedOffAt   DateTime?       @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(6)

  office      Office      @relation(fields: [officeId], references: [id], onDelete: Cascade)
  case        Case        @relation(fields: [officeId, caseId], references: [officeId, id], onDelete: Cascade)
  client      Client?     @relation(fields: [officeId, clientId], references: [officeId, id], onDelete: NoAction)
  sourceOrder CourtOrder? @relation(fields: [officeId, sourceOrderId], references: [officeId, id], onDelete: NoAction)

  @@unique([officeId, sourceOrderId, lang], map: "message_one_draft_per_order_lang_uniq", where: raw("\"sourceOrderId\" IS NOT NULL"))
  @@index([officeId, caseId, createdAt])
  @@schema("app")
}

// ---------------------------------------------------------------- legal research

model ResearchReport {
  id        String   @id @default(cuid())
  officeId  String
  caseId    String
  title     String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  office   Office            @relation(fields: [officeId], references: [id], onDelete: Cascade)
  case     Case              @relation(fields: [officeId, caseId], references: [officeId, id], onDelete: Cascade)
  versions ResearchVersion[]
  tasks    Task[]

  @@unique([officeId, id])
  @@index([officeId, caseId])
  @@schema("app")
}

/// One run of the research pipeline. The analysis is a fixed snapshot (JSON) and is never edited after
/// creation; only `status` and notes change. A rerun creates a new version.
model ResearchVersion {
  id                     String       @id @default(cuid())
  officeId               String
  reportId               String
  version                Int
  question               String
  actingFor              PartySide?
  mode                   ResearchMode
  pipeline               String
  status                 ReviewStatus @default(NEEDS_REVIEW)
  summary                String
  orderIds               String[]     @default([])
  documentIds            String[]     @default([])
  issues                 Json         @default("[]")
  provisions             Json         @default("[]")
  arguments              Json         @default("[]")
  counterarguments       Json         @default("[]")
  missingFacts           Json         @default("[]")
  nextSteps              Json         @default("[]")
  limitations            Json         @default("[]")
  sourcesChecked         Json         @default("[]")
  bookmarkedProvisionIds String[]     @default([])
  createdById            String?
  createdAt              DateTime     @default(now()) @db.Timestamptz(6)
  reviewedAt             DateTime?    @db.Timestamptz(6)

  office      Office              @relation(fields: [officeId], references: [id], onDelete: Cascade)
  report      ResearchReport      @relation(fields: [officeId, reportId], references: [officeId, id], onDelete: Cascade)
  authorities ResearchAuthority[]
  notes       ResearchNote[]

  @@unique([officeId, id])
  @@unique([reportId, version])
  @@schema("app")
}

/// A judgment cited in a research version. Name, citation, court, date and URL are copied from the source
/// record (never written by the AI). `judgmentId` points at public.legal_judgments when it came from open data.
model ResearchAuthority {
  id            String       @id @default(cuid())
  officeId      String
  versionId     String
  connector     String // "demo" | "ecourts-opendata" | "indiankanoon"
  sourceId      String
  judgmentId    String? // public.legal_judgments.id (no foreign key: that table is outside this schema)
  name          String
  citation      String?
  court         String
  decisionDate  DateTime?    @db.Date
  bench         String?
  url           String?
  issue         String       @default("")
  materialFacts String       @default("")
  principle     String       @default("")
  relevance     String       @default("")
  distinctions  String       @default("")
  passages      Json         @default("[]")
  treatment     String? // subsequent treatment (good law), when a source provides it
  stance        Stance       @default(UNCLASSIFIED)
  bindingness   Bindingness  @default(UNKNOWN)
  verification  Verification
  isFictional   Boolean      @default(false)
  reviewedById  String?
  reviewedAt    DateTime?    @db.Timestamptz(6)
  position      Int          @default(0)

  office  Office           @relation(fields: [officeId], references: [id], onDelete: Cascade)
  version ResearchVersion  @relation(fields: [officeId, versionId], references: [officeId, id], onDelete: Cascade)
  saved   SavedAuthority[]

  @@unique([officeId, id])
  @@unique([versionId, sourceId])
  @@index([officeId, judgmentId])
  @@schema("app")
}

model SavedAuthority {
  id          String   @id @default(cuid())
  officeId    String
  caseId      String
  authorityId String
  savedById   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  office    Office            @relation(fields: [officeId], references: [id], onDelete: Cascade)
  case      Case              @relation(fields: [officeId, caseId], references: [officeId, id], onDelete: Cascade)
  authority ResearchAuthority @relation(fields: [officeId, authorityId], references: [officeId, id], onDelete: Cascade)

  @@unique([caseId, authorityId])
  @@schema("app")
}

model ResearchNote {
  id        String     @id @default(cuid())
  officeId  String
  versionId String
  text      String
  author    NoteAuthor
  authorId  String?
  createdAt DateTime   @default(now()) @db.Timestamptz(6)

  office  Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  version ResearchVersion @relation(fields: [officeId, versionId], references: [officeId, id], onDelete: Cascade)

  @@index([officeId, versionId, createdAt])
  @@schema("app")
}

// ---------------------------------------------------------------- audit

/// Append-only. The app never updates or deletes these rows.
model AuditLog {
  id       String   @id @default(cuid())
  officeId String
  userId   String?
  action   String // e.g. "order.approved", "hearing.date_changed"
  entity   String
  entityId String
  caseId   String?
  detail   String   @default("")
  at       DateTime @default(now()) @db.Timestamptz(6)

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@index([officeId, at(sort: Desc)])
  @@index([officeId, caseId, at])
  @@schema("app")
}
